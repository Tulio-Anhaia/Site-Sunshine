# Variaveis de ambiente - preencher antes do deploy em producao
# Nao commitar o arquivo .env.local com valores reais

NEXT_PUBLIC_SITE_URL=https://sunshineesportes.com.br

# Google Analytics (GA4) - [A CONFIGURAR]
NEXT_PUBLIC_GA_ID=

# Google Search Console - [A CONFIGURAR]
NEXT_PUBLIC_GSC_VERIFICATION=

# Endpoint do formulario de contato/patrocinio - [A CONFIGURAR]
# Ex: servico de email transacional, webhook de CRM, etc.
FORM_SUBMISSION_ENDPOINT=

# WhatsApp Business (validar numero antes de publicar - ver lib/data.ts)
